# Neon PostgreSQL: use pooled connection string for runtime queries.
# Neon console provides pooled and direct connection strings.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/likha?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/likha?sslmode=require"

# Upstash Redis REST credentials (Vercel Marketplace integration).
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

NEXTAUTH_SECRET=replace-with-32-byte-random-secret
NEXTAUTH_URL=http://localhost:3000
INTERNAL_API_TOKEN=replace-with-long-random-token
GITHUB_API_TOKEN=
GITHUB_OWNER=phlopentech
GITHUB_WORKFLOW_REPO=likha-workflows
GITHUB_WORKFLOW_FILE=project-build.yaml
GITHUB_DEFAULT_REF=main
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
LIKHA_PUBLIC_URL=https://likha.phlopentech.org
GHCR_OWNER=phlopentech
BLOCK_HIGH=false
